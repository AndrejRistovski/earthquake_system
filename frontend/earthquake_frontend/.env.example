# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment. Copy to .env for local dev:  cp .env.example .env
#
# WARNING: every VITE_* value is BAKED INTO THE CLIENT BUNDLE at `vite build`
# and ships to the browser. Never put secrets here. There is NO runtime override
# — Vite inlines these at build time (intentional for this project).
# ─────────────────────────────────────────────────────────────────────────────

# Base URL the bundle is built against.
#   • Local dev / preview:  http://localhost:9090   (backend on the host)
#   • docker compose (nginx /api proxy): the compose build arg sets this to ""
#     so the bundle issues same-origin /api/* requests; you do NOT set it here.
VITE_API_BASE_URL=http://localhost:9090
